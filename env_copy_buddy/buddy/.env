# Environment
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/infinitepay-db?schema=public&sslmode=disable"
CLEAN_DB=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-at-least-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production-use-different-from-jwt-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=infinite-auth
JWT_AUDIENCE=infinite-users

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=infinitepay-db
POSTGRES_PORT=5432


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Settings
DEFAULT_EMAIL_SENDER=noreply@infinitepay.tech
EMAIL_FROM_NAME=Infinite
APP_DOMAIN=http://localhost:4200
SUPPORT_EMAIL=customer.services@infinitepay.tech
SUPPORT_PHONE="+353 1 447 5299"

# Mailer Service
MAILER_SERVICE_URL=http://localhost:3006/api/v1

# SMSer Service
SMSER_SERVICE_URL=http://localhost:3002/api/v1
# Twilio Credentials
TWILIO_ACCOUNT_SID=XXXXXX
TWILIO_AUTH_TOKEN=XXXXXX
TWILIO_SENDER_NUMBER=+12000000000
# TEXTMAGIC
APP_TEXT_MAGIC_API_KEY=XXXXXX
APP_TEXT_MAGIC_USERNAME=XXXXXX

# API Gateway
GATEWAY_PORT=3000
API_PREFIX=api/v1
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
CORS_ORIGIN=http://localhost:4200,http://localhost:3000
GATEWAY_URL=http://localhost:3000/api/v1

# Password reset
PASSWORD_RESET_COOLDOWN_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24

# Account activation
ACTIVATION_TOKEN_EXPIRY_HOURS=24
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:4200,http://localhost:3000


# Logging
LOG_LEVEL=debug

# PostHog Configuration (Analytics, Error Tracking, Feature Flags)
POSTHOG_API_KEY=your_posthog_project_api_key
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_LOGS_ENABLED=false

# AWS Configuration
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Event Bridge Configuration
EVENTBRIDGE_BUS_NAME="infinite-event-bus"
EVENTBRIDGE_ENABLED="false"

# SNS Configuration
SNS_ENABLED=false

# SQS Configuration
SQS_ENABLED=false

# SonarCloud Configuration
# Used for local code quality and coverage analysis before submitting PRs
SONAR_TOKEN=e41dc2d811e4670b2f6fd7b6a25ab31b61b9cd0c

# Datadog Configuration (Real User Monitoring + Application Performance Monitoring)
# Enables end-to-end observability by correlating frontend user sessions with backend traces
# For setup instructions, see: apps/buddy/src/lib/datadog/README.md

## Frontend RUM Configuration (see apps/buddy/.env.example for detailed frontend settings)
# NEXT_PUBLIC_DATADOG_RUM_ENABLED=true
# NEXT_PUBLIC_DATADOG_APPLICATION_ID=your-app-id
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=your-client-token
# NEXT_PUBLIC_DATADOG_ALLOWED_TRACING_URLS=http://localhost:3000,http://localhost:4000
# NEXT_PUBLIC_DATADOG_TRACE_CONTEXT_INJECTION=sampled

## Backend APM Configuration (see individual app .env.example files)
# DD_TRACE_ENABLED=true
# DD_API_KEY=your-datadog-api-key
# DD_SERVICE=buddy (recommended: use service name for each app)
# DD_ENV=dev
# DD_SITE=datadoghq.eu
# DD_TRACE_SAMPLE_RATE=1.0

# Settle local testing — LocalStack
SQS_ENABLED=true
SNS_ENABLED=true
EVENTBRIDGE_ENABLED=true
AWS_SQS_ENDPOINT=http://localhost:4566
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_FORCE_PATH_STYLE=true
LOCALSTACK_ENABLED=true
SETTLE_INGEST_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/settle-ingest-queue
SETTLE_CALC_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/settle-calc-queue
INFINITE_MASTER_ACCOUNT_ID="019d1f2b-485f-7046-828b-779697165deb"

SETTLE_DATABASE_URL="postgresql://settle_admin:password123@localhost:5433/settle_db?sslmode=disable"
SETTLE_POSTGRES_USER=settle_admin
SETTLE_POSTGRES_PASSWORD=password123
SETTLE_POSTGRES_DB=settle_db
SETTLE_POSTGRES_PORT=5433

