
# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3014
API_PREFIX=api/v1
ENABLE_SWAGGER=true

# ─── Banking Circle webhook encryption ────────────────────────────────────────
# Must be a base64-encoded 32-byte (256-bit) key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# This key must also be placed in bruno/bc-webhook/.env so gen-payload.mjs and
# the running service share the same key.
BC_WEBHOOK_ENCRYPTION_KEY=ThqrVPRt22gE22nErzZ56g+Lm/2XryOu7l0+mudW4Bk=

# ─── SQS queue URLs ───────────────────────────────────────────────────────────
# Ingress queue — BC delivers encrypted payloads here via the HTTP endpoint.
# BC_WEBHOOK_SQS_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/bc-webhook-events
BC_WEBHOOK_SQS_URL=http://localhost:4566/000000000000/ipt-local-bc-webhook-events-queue

# Downstream queue — normalised BC payment events published for other services.
# BC_PAYMENT_EVENTS_SQS_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/bc-payment-events
BC_PAYMENT_EVENTS_SQS_URL=http://localhost:4566/000000000000/ipt-local-bc-payment-events-queue

# ─── AWS / LocalStack ─────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
# Point the SQS SDK at the LocalStack container (compose service name).
AWS_SQS_ENDPOINT=http://localhost:4566
SQS_ENABLED=true

# ─── Settle DB ────────────────────────────────────────────────────────────────
# Overridden by the docker-compose environment block at runtime; set here so
# the app can start outside of compose (e.g. bare `node dist/main.js`).
# SETTLE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/settle_db?schema=public&sslmode=disable
SETTLE_DATABASE_URL="postgresql://settle_admin:password123@localhost:5433/settle_db?sslmode=disable"



# mocks:
BC_API_MTLS_ENABLED=false
BC_AUTH_BASE_URL=http://localhost:3099
BC_API_BASE_URL=http://localhost:3099

# for integration testing (local)
BC_WEBHOOK_CONSUMER_ENABLED=false
