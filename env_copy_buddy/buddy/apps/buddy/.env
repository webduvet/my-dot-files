
# Cookie name used for storing user's locale preference (e.g., "NEXT_LOCALE")
I18N_COOKIE_NAME="XXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Authentication & Security
AUTH_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXTAUTH_URL="http://localhost:4200"

#Required: Name of the cookie storing the access & refresh token
ACCESS_COOKIE_NAME=Authentication
REFRESH_COOKIE_NAME=Refresh

# Required: Base URL for the authentication platform (refer to auth app PORT env variable)
PLATFORM_URL=http://localhost:4000/api

# Required: Base URL for the gateway service (only implemented for auth module currently)
GATEWAY_URL=http://localhost:3000/api/v1

# Required: Base URL for the validation service (server-side only)
VALIDATION_SERVICE_API_URL=http://localhost:3000

# Server-side Gateway Configuration
# Local development: GATEWAY_HOST=http://localhost
# Container environment: GATEWAY_HOST=http://gateway (service name from docker-compose)
GATEWAY_HOST=http://localhost
GATEWAY_PORT=3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000/api/v1
# Required: Base URL - next.config.ts
FLAGCDN_HOST=flagcdn.com
WIKI_HOST=upload.wikimedia.org

# postgoh
NEXT_PUBLIC_POSTHOG_KEY=phc_hXvpm7MXDN6Uax02R8mMlRTHYxvs3U1e4E7vy7EGY9H
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_ID=40662
# PostHog Source Maps Upload (for Error Tracking stack traces)
# Get Personal API Key from: https://eu.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=your_personal_api_key
# Get Environment ID from: Project Settings -> General
POSTHOG_ENV_ID=your_environment_id

# Environment identifier (dev, uat, prod)
NEXT_PUBLIC_APP_ENV=dev

# Buddy version
BUDDY_VERSION="0.0.1"

# Datadog RUM Configuration (POC - Real User Monitoring)
# Enable/disable Datadog RUM monitoring (set to 'true' to enable)
NEXT_PUBLIC_DATADOG_RUM_ENABLED=true
# Datadog application ID for RUM
NEXT_PUBLIC_DATADOG_APPLICATION_ID=
# Datadog client token for RUM
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=
# Datadog site (datadoghq.com, datadoghq.eu, us3.datadoghq.com, etc.)
NEXT_PUBLIC_DATADOG_SITE=datadoghq.eu
# Service name (defaults to 'buddy' if not set) - Required for RUM-APM correlation
NEXT_PUBLIC_DATADOG_SERVICE=buddy
# Session sampling rate (0-100, percentage of sessions to track)
NEXT_PUBLIC_DATADOG_SESSION_SAMPLE_RATE=100
# Session replay sampling rate (0-100, percentage of tracked sessions to record)
NEXT_PUBLIC_DATADOG_SESSION_REPLAY_SAMPLE_RATE=20
# Privacy level: 'mask-user-input', 'mask', or 'allow'
NEXT_PUBLIC_DATADOG_DEFAULT_PRIVACY_LEVEL=mask-user-input

# Datadog RUM-APM Correlation Configuration
# See: https://docs.datadoghq.com/real_user_monitoring/correlate_with_other_telemetry/apm/
# Comma-separated list of URLs to enable trace context injection (frontend → backend)
NEXT_PUBLIC_DATADOG_ALLOWED_TRACING_URLS=http://localhost:3000,http://localhost:4000,http://localhost:3006
# Backend trace sampling rate (0-100): controls percentage of backend traces ingested
# Note: Only impacts backend traces, not RUM sessions
NEXT_PUBLIC_DATADOG_TRACE_SAMPLE_RATE=100
# Trace context injection mode: 'all' (inject trace headers in all requests), 'sampled' (only in sampled requests)
NEXT_PUBLIC_DATADOG_TRACE_CONTEXT_INJECTION=sampled

NEXT_PUBLIC_AUTH_SHARED_COOKIE_DOMAIN_SUFFIX=localhost
AUTH_SHARED_COOKIE_DOMAIN_SUFFIX=localhost

# Disable OTP for local dev (avoids SMSer dependency; team uses same for local)
OTP_ENABLED=false
OTP_TOKEN_LENGTH=6
OTP_TOKEN_EXPIRES_IN_MINUTES=10
OTP_SMS_MESSAGE="Your verification code is: {{code}}"
