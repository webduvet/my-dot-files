GLOBAL_PREFIX=api/v1
NODE_ENV=development
GATEWAY_PORT=3000
JWT_ISSUER=buddy-auth
JWT_AUDIENCE=buddy-api
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-at-least-32-characters
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production-use-different-from-jwt-secret
JWT_ALG=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=86400
JwtStrategy=buddy-auth
DATABASE_URL="postgresql://postgres:password@localhost:5432/infinitepay-db?schema=public&sslmode=disable"
DAL_SERVICE_URL=http://localhost:2999/api
SMSER_SERVICE_URL=http://localhost:3002/api/v1
AUTH_SERVICE_URL=http://localhost:4000/api
VALIDATION_SERVICE_API_URL=http://localhost:4000
VALIDATION_REQUEST_TIMEOUT=30000
MAILER_SERVICE_URL=http://localhost:3006
DOCUMENT_SERVICE_URL=http://localhost:3004/api/v1

CORS_ORIGIN=http://localhost:4200

OTP_ENABLED=false
OTP_TOKEN_LENGTH=6
OTP_TOKEN_EXPIRES_IN_MINUTES=10
OTP_SMS_MESSAGE="Your verification code is: {{code}}"

AUTH_SHARED_COOKIE_DOMAIN_SUFFIX=localhost

# Token Expiry Configuration
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=24
ACTIVATION_TOKEN_EXPIRY_HOURS=24

# PostHog Configuration (Analytics, Error Tracking, Feature Flags)
POSTHOG_API_KEY=your_posthog_project_api_key
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_LOGS_ENABLED=false
SERVICE_NAME=gateway

# Cache Configuration (in milliseconds)
# Controls how long cache results are stored based on their outcome
CACHE_VALID_TTL_MS=86400000    # Valid results cache duration
CACHE_INVALID_TTL_MS=120000    # Invalid results cache duration
CACHE_ERROR_TTL_MS=60000       # Error results cache duration

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_ENABLED=0

# Datadog APM Configuration (Application Performance Monitoring)
# Enable/disable APM tracing
DD_TRACE_ENABLED=true
# Datadog API key for APM
DD_API_KEY=
# Service name for APM traces (logical name for this backend; can differ from frontend service name)
DD_SERVICE=gateway
# Environment name for APM (dev, uat, prod) – must align with frontend and propagated trace headers for correlation
DD_ENV=dev
# Service version for APM
DD_VERSION=
# Datadog site (datadoghq.com, datadoghq.eu, us3.datadoghq.com, etc.)
DD_SITE=datadoghq.eu
# Sampling rate (0.0 to 1.0)
# Controls the percentage of requests traced to manage ingestion volume
DD_TRACE_SAMPLE_RATE=1.0
# Optional: Set to 'true' to log trace IDs for every request (may increase log volume)
DD_TRACE_LOG_REQUESTS=false

ACI_API_BASE_URL=https://eu-test.oppwa.com
ACI_PSP_ID=8ac7a4ca9a8fe15c019a91a3eda702e1
ACI_USERNAME="webapi@infinitepay.com"
ACI_PASSWORD="%@Cf2MH7#gRAMWx6sXe5"

CAPTCHAFOX_ENABLED=false
CAPTCHAFOX_SECRET_KEY=ok_11111111000000001111111100000000
CAPTCHAFOX_API_BASE_URL=https://xxxxxxxxx.com

# B4B Oversight API
B4B_API_BASE_URL=https://oversight.b4b.eu
B4B_AUTH_URL=https://auth.b4b.eu/oauth/token
B4B_CLIENT_ID=
B4B_CLIENT_SECRET=
B4B_TOKEN_BUFFER_SECONDS=60
