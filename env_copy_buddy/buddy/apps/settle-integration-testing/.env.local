# LocalStack Configuration
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 Buckets
SETTLE_INCOMING_BUCKET=ipt-dev-settle-incoming
SETTLE_INGEST_BUCKET=ipt-dev-settle-ingest
SETTLE_S3_BUCKET=ipt-dev-settle-incoming
INGEST_S3_BUCKET=ipt-dev-settle-ingest
SETTLEMENT_S3_BUCKET=ipt-dev-settle-incoming

# SQS Queue URLs (LocalStack format)
SETTLE_INGEST_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/settle-ingest-queue
SETTLE_CALC_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/settle-calc-queue
ACCOUNTS_SETTLEMENT_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/accounts-settlement-queue
SETTLE_REPORTING_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/settle-reporting-queue
SETTLE_BILLING_STATEMENTS_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/settle-billing-statements-queue
SETTLE_ENABLEMENT_QUEUE_URL=http://sqs.eu-west-1.localhost.localstack.cloud:4566/000000000000/settle-enablement-queue
EVENTBRIDGE_BUS_NAME=default
ACQUIRER_FTS_INTERNAL_API_KEY=local-test-token
MAILER_INTERNAL_API_KEY=local-test-token

# settle-processing HTTP server
ORCHESTRATOR_URL=http://localhost:3008
ORCHESTRATOR_API_AUTH_TOKEN=local-test-token

# Database (settle-db from docker-compose)
SETTLE_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/settle_db?schema=public&sslmode=disable
DATABASE_URL=postgresql://root:password@localhost:5432/buddy_infinite?schema=public&sslmode=disable

# Internal master account (required by settle-calc / accounts-settlement)
INFINITE_MASTER_ACCOUNT_ID=019e0000-0000-7000-8000-000000000001

# Worker Configuration
WORKER_POLL_INTERVAL_MS=1000
WORKER_VISIBILITY_TIMEOUT=30

EVENTBRIDGE_ENABLED=true

# Worker enable/disable flags (explicitly set to 'true' to run)
WORKER_ENABLE_PROCESSING=true
WORKER_ENABLE_MAILER=true
WORKER_ENABLE_INGEST=true
WORKER_ENABLE_CALC=true
WORKER_ENABLE_ACCOUNTS_SETTLEMENT=true
WORKER_ENABLE_REPORTING=true
WORKER_ENABLE_BILLING_STATEMENTS=true
WORKER_ENABLE_SETTLE_ENABLEMENT=true
PORT=3008
DAILY_SETTLEMENT_REPORT_EMAIL_RECIPIENTS=qa@example.com
MERCHANT_BILLING_STATEMENT_REPORT_EMAIL_RECIPIENTS=qa@example.com
