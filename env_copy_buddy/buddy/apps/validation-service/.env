# Bank Details Validation Service Environment Variables

# CORS Configuration - Origin allowed to make cross-origin requests
# Development: http://localhost:4200
# Production: https://yourdomain.com
CORS_ORIGIN='http://localhost:4200'

# Address/Loqate Service
LOQATE_BASE_URL='xxxxxxxxxxxxxxxxxx'
LOQATE_API_KEY='xxxxxxxxxxxxxxxxxx'

# UK Vat Number Validation Service Environment Variables

HMRC_OAUTH_URL='xxxxxxxxxxxxxxxxxx'
HMRC_API_BASE_URL='xxxxxxxxxxxxxxxxxx'
HMRC_CLIENT_ID='xxxxxxxxxxxxxxxxxx'
HMRC_CLIENT_SECRET='xxxxxxxxxxxxxxxxxx'
COMPANY_HOUSE_API_BASE_URL="xxxxxxxxxxxxxxxxxx"
COMPANY_HOUSE_API_KEY="xxxxxxxxxxxxxxxxxx"

# Ireland VAT Number Validation Service Environment Variables
CREDITSAFE_API_URL="xxxxxxxxxxxxxxxxxx"
CREDITSAFE_USERNAME="xxxxxxxxxxxxxxxxxx"
CREDITSAFE_PASSWORD="xxxxxxxxxxxxxxxxxx"
VATLAYER_API_KEY="xxxxxxxxxxxxxxxxxx"
VATLAYER_API_URL="xxxxxxxxxxxxxxxxxx"
HITHORIZON_API_KEY="xxxxxxxxxxxxxxxxxx"
HITHORIZON_API_BASE_URL="xxxxxxxxxxxxxxxxxx"

# Vendor API Workarounds
# TEMP_WORKAROUND: Set any of these to 'true' to force bypassing the live vendor API and using
# safe stub responses instead. Intended for incident mitigation only.
HITHORIZON_WORKAROUND_FORCE="false"
HMRC_WORKAROUND_FORCE="false"
COMPANY_HOUSE_WORKAROUND_FORCE="false"
CREDITSAFE_WORKAROUND_FORCE="false"
VATLAYER_WORKAROUND_FORCE="false"
LOQATE_WORKAROUND_FORCE="false"

# Cache Configuration (in milliseconds)
# Controls how long validation results are cached based on their outcome
CACHE_VALID_TTL_MS=86400000    # Valid results cache duration (default: 24 hours)
CACHE_INVALID_TTL_MS=120000    # Invalid results cache duration (default: 2 minutes)
CACHE_ERROR_TTL_MS=60000       # Error results cache duration (default: 1 minute)

PORT=4300
