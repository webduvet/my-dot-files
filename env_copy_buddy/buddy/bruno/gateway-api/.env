# Bruno API collection vars (Bruno loads these for requests)
base_url=http://localhost:3000
# Login: must be a valid email (gateway LoginDto). Matches prisma seed admin by default.
email=admin@infinitepay.tech
password=Password12345!
# Legacy alias (same value as email) — still read by scripts and collection pre-request
# username=
q=GB
# access_token=  # optional: inject to skip login

# =============================================================================
# API Test E2E: vars for gateway + Bruno (used by run-api-test-e2e.mjs)
# For GitHub Actions: map these to secrets — e.g. API_TEST_EMAIL: ${{ secrets.API_TEST_EMAIL }}
# =============================================================================

# Gateway — required for login to work (GitHub: secrets.GATEWAY_* or vars)
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=86400
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-at-least-32-characters
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production-use-different-from-jwt-secret
JWT_ISSUER=buddy-auth
JWT_AUDIENCE=buddy-api
GATEWAY_PORT=3000
NODE_ENV=development
# Disable OTP for api-test so login returns tokens (not requireOTP)
OTP_ENABLED=false

# Gateway — database & services (GitHub: secrets.DATABASE_URL, etc.)
DATABASE_URL=postgresql://root:password@localhost:5432/infinitepay-db?schema=public&sslmode=disable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=0

# Bruno login credentials for api-test-e2e (CI: secrets.API_TEST_EMAIL / API_TEST_PASSWORD)
# Legacy: API_TEST_USERNAME is still accepted if API_TEST_EMAIL is unset
API_TEST_EMAIL=
API_TEST_PASSWORD=
API_TEST_USERNAME=

# =============================================================================
# Document service (SignNow) — direct calls bypass the Gateway
# =============================================================================
# Base URL for the Document service (default: http://localhost:3004/api)
DOCUMENT_API_BASE=http://localhost:3004/api
# Internal API key for admin SignNow endpoints — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNNOW_INTERNAL_API_KEY=
# Webhook signature header value — leave empty to skip signature validation in dev,
# or set to the HMAC-SHA256 signature of the request body for production testing
SIGNNOW_WEBHOOK_SIGNATURE=
