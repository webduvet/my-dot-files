// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace && !Terminal && vim_mode == normal",
    "bindings": {
      ", n": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      // "j k": "vim::SwitchToNormalMode"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu && !terminal",
    "bindings": {
      "shift-j": "vim::ScrollDown",
      "shift-k": "vim::ScrollUp",
      ", b": "file_finder::Toggle",
      ", q": "pane::CloseActiveItem",
      ", n": "workspace::ToggleLeftDock",
      ", a": "agent::ToggleFocus",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      ", f": "file_finder::Toggle"
    }
  },
  {
    "context": "agent && vim_mode == normal && !menu && !terminal",
    "bindings": {
      ", a": "agent::ToggleFocus"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {}
  },
  {
    "context": "file_finder",
    "bindings": {
      "ctrl-j": "pane::ActivateNextItem",
      "ctrl-k": "pane::ActivatePreviousItem"
    }
  },
  {
    "context": "Dock",
    "bindings": {
      ", n": "workspace::ToggleLeftDock",
      // "ctrl-l": "workspace::ActivatePaneLeft"
      "ctrl-l": "editor::ToggleFocus"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious"
    }
  }
]
