  "edit_predictions": {
    "provider": "copilot",
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": "GITHUB_PERSONAL_ACCESS_TOKEN",
      },
    },
    "postgres-context-server": {
      "enabled": true,
      "remote": false,
      "settings": {},
    },
    "mcp-server-figma": {
      "enabled": true,
      "settings": {
        "figma_api_key": "YOUR_FIGMA_ACCESS_TOKEN",
      },
    },
  },
  "project_panel": {
    "dock": "left",
    "auto_reveal_entries": false,
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "docs.bankingcircleconnect.com"
      ]
    },
    "dock": "right",
    "profiles": {
      "custom": {
        "name": "Custom",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-github": {
            "tools": {
              "create_pull_request": true,
            },
          },
          "mcp-server-context7": {
            "tools": {
              "resolve-library-id": true,
            },
          },
          "mcp-server-figma": {
            "tools": {
              "download_figma_images": true,
              "get_figma_data": true,
            },
          },
          "prisma-mcp": {
            "tools": {
              "Prisma-Studio": true,
              "migrate-dev": true,
              "migrate-reset": true,
              "migrate-status": true,
            },
          },
        },
      },
      "write": {
        "name": "write",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://docs\\.bankingcircleconnect\\.com"
            }
          ]
        },
        "move_path": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^pr_buddy/apps/webhooks/src/app/",
            },
          ],
        },
        "delete_path": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^pr_buddy/apps/webhooks/src/",
            },
            {
              "pattern": "^pr_buddy/apps/webhooks/",
            },
          ],
        },
        "copy_path": {
          "always_allow": [
            {
              "pattern": "^pr_buddy/apps/",
            },
          ],
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^pnpm\\s+nx(\\s|$)",
            },
            {
              "pattern": "^ls\\s+/home/andrej/infinite/(\\s|$)",
            },
            {
              "pattern": "^ls\\s+/home/andrej/infinite/npi-cloud/(\\s|$)",
            },
          ],
        },
        "open": {
          "default": "allow",
        },
        "edit_file": {
          "always_allow": [
            {
              "pattern": "^buddy/\\.zed/contexts/",
            },
          ],
        },
        "create_directory": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^buddy/\\.zed/",
            },
          ],
        },
      },
    },
    "play_sound_when_agent_done": "always",
    "default_profile": "ask",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
    },
    "model_parameters": [],
    "default_model": {
      "enable_thinking": false,
      "provider": "Z.ai",
      "model": "glm-5.2",
    },
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "off",
    },
  },
  "telemetry": {
    "metrics": false,
  },
  "vim_mode": true,
  "ui_font_size": 17.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Crisp Anysphere Blend Light",
    // "dark": "Dark Pop UI"
    "dark": "Gruvbox Dark Soft",
  },
  "buffer_font_features": {
    "calt": true,
  },
  "tabs": {
    "close_position": "right",
    "show_close_button": "always",
  },
}
