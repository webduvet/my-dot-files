            "max_output_tokens": 384000,
          },
          {
            "name": "glm-4.6",
            "display_name": "GLM 4.6",
            "max_tokens": 1048576,
            "max_output_tokens": 384000,
          },
        ],
      },
      "DeepSeekV4_manual": {
        "api_url": "https://api.deepseek.com",
        "available_models": [
          {
            "name": "deepseek-v4-pro",
            "max_tokens": 1048576,
