            "name": "zai-glm-4.7",
            "max_tokens": 131072,
            "max_output_tokens": 131000,
            "max_completion_tokens": 131000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
